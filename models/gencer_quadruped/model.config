<?xml version="1.0"?>
<model>
  <name>my_quadruped</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>

  <author>
    <name>Arda</name>
  </author>

  <description>
    Quadruped robot model. Mass/inertia reflect real CubeMars AK80-9 actuators
    (485g each, split 65/35 stator/rotor) and joint effort limits are set to
    the AK80-9's 18 N*m peak torque. Visual/collision meshes are the
    realism-fixed geometry (ABAD/HIP motor cans + bracket fused per leg,
    L/R-correct thigh and shank) -- not yet the fully-manufacturable
    real-actuator CAD from the separate design package.
  </description>
</model>
